<style>
  .poly-container {
    font-family: Arial, sans-serif;
    padding: 20px;
  }
  .poly-container form {
    max-width: 300px;
    padding: 15px;
    border: 1px solid #ccc;
    border-radius: 6px;
  }
  .poly-container label {
    display: block;
    margin-top: 12px;
    font-weight: bold;
  }
  .poly-container input,
  .poly-container select {
    width: 100%;
    padding: 6px;
    margin-top: 5px;
  }
  .poly-container button {
    margin-top: 15px;
    padding: 8px 12px;
    width: 100%;
  }
</style>

<div class="poly-container">
  <h3>Polymerisation Parameters</h3>

  <label for="temperature">Temperature (°C)</label>
  <input type="number" id="temperature" name="temperature" style="width: 100px">

  <label for="method">Polymerisation Method</label>
  <select id="method" name="polymerisationMethod">
    <option value="na">n/a</option>

    <optgroup label="Common process modes">
      <option value="bulk">Bulk</option>
      <option value="solvent">Solvent / Solution</option>
      <option value="emulsion">Emulsion</option>
      <option value="suspension">Suspension</option>
      <option value="precipitation">Precipitation</option>
      <option value="slurry">Slurry</option>
      <option value="gas phase">Gas phase</option>
      <option value="aqueous dispersion">Aqueous dispersion</option>
    </optgroup>

    <optgroup label="Special process variants">
      <option value="microemulsion">Microemulsion</option>
      <option value="miniemulsion">Miniemulsion</option>
      <option value="inverse emulsion">Inverse emulsion</option>
      <option value="semicontinuous">Semicontinuous</option>
      <option value="sealed tube">Sealed tube</option>
      <option value="confined">Confined</option>
      <option value="surface-initiated">Surface-initiated</option>
    </optgroup>
  </select>

  <label for="type">Polymerisation Type</label>
  <select id="type" name="polymerisationType">
    <option value="na">n/a</option>

    <optgroup label="Radical polymerization">
      <option value="free radical">Free radical</option>
      <option value="controlled radical">Controlled/Living radical (ATRP, RAFT, RDRP)</option>
    </optgroup>

    <optgroup label="Ionic / coordination">
      <option value="cationic">Cationic</option>
      <option value="anionic">Anionic</option>
      <option value="coordination">Coordination (e.g., Ziegler–Natta, metallocene)</option>
    </optgroup>

    <optgroup label="Ring-opening / step-growth">
      <option value="ring-opening polymerization">Ring-opening (ROP)</option>
      <option value="ring opening metathesis polymerization">Ring-opening metathesis (ROMP)</option>
      <option value="step-growth">Step-growth</option>
    </optgroup>
  </select>
</div>
